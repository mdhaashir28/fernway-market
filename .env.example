# =====================================================================
#  Meeranji Supermarket — settings
#
#  1. Copy this file to a new file called ".env" in the same folder.
#     ("npm run setup" does this for you and fills in random secrets.)
#  2. Change the values to suit you.
#  3. NEVER commit .env to git or share it — it contains your secrets.
#
#  Everything below is a PLACEHOLDER for local development.
# =====================================================================

# --- Database --------------------------------------------------------
# The default points at the local PostgreSQL started by "npm run db:local"
# (or "npm run dev"). It uses port 5433 so it won't clash with a PostgreSQL
# you may have installed yourself on the usual port 5432.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgres://fernway:replace-with-a-database-password@localhost:5433/fernway_market

# --- API server ------------------------------------------------------
PORT=4000
# Secret used to sign login tokens. Must be long and random. Anyone who knows
# it could forge logins, so keep it private. "npm run setup" generates one.
JWT_SECRET=replace-with-a-long-random-secret
# How long a login lasts before the user must log in again (e.g. 12h, 7d).
JWT_EXPIRES_IN=7d
# Web addresses allowed to call the API from a browser (staff dashboard and
# the Expo web preview). Phone apps don't need to be listed here.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Where uploaded product photos are kept: "disk" (backend/uploads) or
# "database" (use this on hosting plans that wipe their disk on each deploy).
IMAGE_STORAGE=disk
# Only for demo deployments: set to true to load sample data even when
# NODE_ENV=production. Leave false for a real store.
LOAD_SAMPLE_DATA=false

# --- Your store ------------------------------------------------------
STORE_NAME=Meeranji Supermarket
# Keep the quotes: without them, everything after "#" would be ignored.
STORE_ADDRESS="#78/153 Bazaar Street, Pernambut - 635 810, Vellore District, Tamil Nadu"
# One or more phone numbers, separated by commas. Shown with tap-to-call links.
STORE_PHONE=9789562928, 9003071616
# 3-letter currency code: INR, USD, GBP, EUR, AUD, ...
# Prices are stored in the smallest unit (paise for INR, cents for USD).
# Note: the sample product prices are written for INR.
CURRENCY=INR
# Your store's time zone (used for pickup times and "today"). Examples:
# Asia/Kolkata, Asia/Dubai, Europe/London, America/New_York, Australia/Sydney
STORE_TIMEZONE=Asia/Kolkata

# --- Store pickup time slots -----------------------------------------
PICKUP_OPEN_HOUR=9
PICKUP_CLOSE_HOUR=20
PICKUP_SLOT_MINUTES=60
# How many orders can be collected in one slot.
PICKUP_SLOT_CAPACITY=6
# How many days ahead customers can book (0 = today only).
PICKUP_DAYS_AHEAD=3
# Customers can't pick a slot that starts sooner than this.
PICKUP_LEAD_TIME_MINUTES=60

# --- Sample accounts (LOCAL DEVELOPMENT ONLY) -------------------------
# Created automatically when the database is empty. Never used in production.
SEED_STAFF_EMAIL=staff@fernway.local
SEED_STAFF_PASSWORD=replace-with-a-staff-password
SEED_CUSTOMER_EMAIL=customer@fernway.local
SEED_CUSTOMER_PASSWORD=replace-with-a-customer-password

# --- Public address of the API -----------------------------------------
# Used to build the secure payment page links. Leave empty on your computer
# (it is worked out from each request). On a live site, e.g.
# PUBLIC_API_URL=https://your-api.example.com
PUBLIC_API_URL=

# --- UPI payments (Razorpay) — see docs/INTEGRATIONS.md -----------------
# demo     = a clearly labelled practice payment screen. No money moves. (default)
# razorpay = UPI through Razorpay's secure checkout. With TEST keys (rzp_test_…)
#            it is Razorpay TEST mode: no real money. Without keys it falls back
#            to the demo screen.
PAYMENTS_MODE=demo
# From Razorpay Dashboard (switch to Test Mode) → Account & Settings → API Keys.
# Use TEST keys only. Never commit real keys.
RAZORPAY_KEY_ID=rzp_test_replace-with-your-key-id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret
# The secret you type when creating the webhook in the Razorpay Dashboard.
RAZORPAY_WEBHOOK_SECRET=replace-with-your-razorpay-webhook-secret
# LIVE keys (rzp_live_…) charge customers real money. The API refuses to start
# with them unless this is true. Keep it false for demos; only change it after
# the go-live checklist in docs/INTEGRATIONS.md.
RAZORPAY_ALLOW_LIVE_PAYMENTS=false
# Unpaid UPI orders are cancelled and their stock released after this many minutes.
PAYMENT_TIMEOUT_MINUTES=15

# --- WhatsApp order updates (official WhatsApp Business Platform) --------
# off       = no WhatsApp messages (customers still see updates in the app)
# demo      = messages are only recorded and previewed in the dashboard (default)
# cloud_api = sent through Meta's WhatsApp Cloud API using approved templates
WHATSAPP_MODE=demo
# From Meta → WhatsApp → API Setup. Use a permanent System User token.
WHATSAPP_ACCESS_TOKEN=replace-with-your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-your-phone-number-id
# Meta App → Settings → Basic → App secret (checks webhook signatures).
WHATSAPP_APP_SECRET=replace-with-your-meta-app-secret
# Any random text; type the same text when you set up the webhook in Meta.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-verify-token
WHATSAPP_API_VERSION=v26.0
# Optional prefix if your approved template names differ, e.g. "meeranji_"
WHATSAPP_TEMPLATE_PREFIX=
# Language codes of your approved templates.
WHATSAPP_TEMPLATE_LANG_EN=en
WHATSAPP_TEMPLATE_LANG_TA=ta
# Number for the "Chat with us on WhatsApp" button (defaults to the first STORE_PHONE).
STORE_WHATSAPP_NUMBER=
